 "script": [
  {
   "id": 1,
   "text": "Was dein Vater gemacht hat, als du Fahrradfahren gelernt hast.",
   "subtitle": false
  },
  {
   "id": 2,
   "text": "Er hat gesagt, er hält dich fest."
  },
  {
   "id": 3,
   "text": "„Ich hab dich. Ich hab dich.“",
   "display": "‚ich hab dich. ich hab dich.‘",
   "speak": "Ich hab dich. Ich hab dich."
  },
  {
   "id": 4,
   "text": "Bei null hat er losgelassen."
  },
  {
   "id": 5,
   "text": "Er ist noch zehn Schritte mitgerannt. Nur für den Fall."
  },
  {
   "id": 6,
   "text": "Du hast nicht gemerkt, dass er losgelassen hat."
  },
  {
   "id": 7,
   "text": "Zwölf Jahre später.",
   "subtitle": false
  },
  {
   "id": 8,
   "text": "Heute hast du deinen Führerschein bekommen."
  },
  {
   "id": 9,
   "text": "Und diesmal hast du ihn mitgenommen."
  },
  {
   "id": 10,
   "text": "Er hat sich festgehalten."
  },
  {
   "id": 11,
   "text": "Und irgendwann hat er losgelassen."
  },
  {
   "id": 12,
   "text": "Früher ist er neben dir hergerannt. Heute sitzt er neben dir."
  }
 ],
