4\u064e\u0648\u0651\u064e\u0627\u062d\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Sie ver\u00e4ndert die Menschen ganz.","footnotes":null},{"id":"5525","sura":"74","aya":"30","arabic_text":"\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u062a\u0650\u0633\u06e1\u0639\u064e\u0629\u064e \u0639\u064e\u0634\u064e\u0631\u064e","translation":"\u00dcber ihr gibt es neunzehn (W\u00e4chter).","footnotes":null},{"id":"5526","sura":"74","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Wir haben als W\u00e4chter des (H\u00f6llen)feuers nur Engel eingesetzt, und Wir haben ihre Zahl nur zu einer Versuchung gemacht f\u00fcr diejenigen, die ungl\u00e4ubig sind, damit diejenigen \u00dcberzeugung gewinnen, denen die Schrift gegeben wurde, und damit diejenigen, die glauben, an Glauben zunehmen, und damit diejenigen, denen die Schrift gegeben wurde, und (auch) die Gl\u00e4ubigen nicht zweifeln und damit diejenigen, in deren Herzen Krankheit ist, und (auch) die Ungl\u00e4ubigen sagen: Was will denn Allah damit als Gleichnis? So l\u00e4\u00dft Allah in die Irre gehen, wen Er will, und leitet recht, wen Er will. Aber niemand wei\u00df \u00fcber die Heerscharen deines Herrn Bescheid au\u00dfer Ihm. Und es ist nur eine Ermahnung f\u00fcr die Menschenwesen.","footnotes":null},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Keineswegs! Beim Mond","footnotes":null},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"und (bei) der Nacht, wenn sie den R\u00fccken kehrt,","footnotes":null},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"und (bei) dem Morgen, wenn er erstrahlt,","footnotes":null},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"sie ist wahrlich eine der gr\u00f6\u00dften (Heimsuchungen)","footnotes":null},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"zur Warnung f\u00fcr die Menschenwesen,","footnotes":null},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"f\u00fcr jemanden von euch, der vorankommen oder zur\u00fcckbleiben will.","footnotes":null},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Jede Seele haftet f\u00fcr das, was sie erworben hat,","footnotes":null},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"au\u00dferdem die Gef\u00e4hrten von der rechten Seite;","footnotes":null},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"sie werden sich in G\u00e4rten befinden, und sie werden einander fragen","footnotes":null},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"nach den \u00dcbelt\u00e4tern:","footnotes":null},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"Was hat euch in Saqar gef\u00fchrt?","footnotes":null},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Sie werden sagen: Wir geh\u00f6rten nicht zu denjenigen, die beteten,","footnotes":null},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"und wir pflegten nicht den Armen zu speisen,","footnotes":null},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"und wir pflegten auf schweifende Reden mit denjenigen einzugehen, die solche f\u00fchrten,","footnotes":null},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"und wir erkl\u00e4rten stets den Tag des Gerichts f\u00fcr L\u00fcge","footnotes":null},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"bis die Gewi\u00dfheit zu uns kam.","footnotes":null},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Nun n\u00fctzt ihnen die F\u00fcrsprache derjenigen nicht, die F\u00fcrsprache einlegen (k\u00f6nnen).","footnotes":null},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Was ist denn mit ihnen, da\u00df sie sich von der Ermahnung abwenden,","footnotes":null},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"als w\u00e4ren sie aufgeschreckte Wildesel,","footnotes":null},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"die vor einem L\u00f6wen fliehen?","footnotes":null},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"Aber nein! Jedermann von ihnen will, da\u00df ihm aufgeschlagene Bl\u00e4tter zukommen.","footnotes":null},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Keineswegs! Vielmehr f\u00fcrchten sie nicht das Jenseits.","footnotes":null},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Keineswegs! Er ist ja eine Erinnerung.","footnotes":null},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Wer nun will, gedenkt seiner.","footnotes":null},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Sie werden aber (seiner) nicht gedenken, au\u00dfer da\u00df Allah es will. Ihm geb\u00fchrt die Gottesfurcht und Ihm geb\u00fchrt die Vergebung.","footnotes":null}]}