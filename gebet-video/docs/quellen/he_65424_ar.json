{"id":"65424","title":"\u0625\u0646 \u0623\u0648\u0644 \u0645\u0627 \u064a\u062d\u0627\u0633\u0628 \u0628\u0647 \u0627\u0644\u0639\u0628\u062f \u0627\u0644\u0635\u0644\u0627\u0629","hadeeth":"\u0639\u0646 \u062a\u0645\u064a\u0645 \u0627\u0644\u062f\u0627\u0631\u064a \u0642\u0627\u0644: \u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645: \"\u0625\u0646 \u0623\u0648\u0644 \u0645\u0627 \u064a\u062d\u0627\u0633\u0628 \u0628\u0647 \u0627\u0644\u0639\u0628\u062f \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u0641\u0625\u0646 \u0648\u064e\u062c\u064e\u062f\u064e \u0635\u0644\u0627\u062a\u064e\u0647 \u0643\u0627\u0645\u0644\u0629\u064b \u0643\u064f\u062a\u0628\u062a \u0644\u0647 \u0643\u0627\u0645\u0644\u0629\u064b\u060c \u0648\u0625\u0646 \u0643\u0627\u0646 \u0641\u064a\u0647\u0627 \u0646\u0642\u0635\u0627\u0646 \u0642\u0627\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0644\u0644\u0645\u0644\u0627\u0626\u0643\u0647: \u0627\u0646\u0638\u0631\u0648\u0627\u060c \u0647\u0644 \u0644\u0639\u0628\u062f\u064a \u0645\u0646 \u062a\u0637\u0648\u0639\u061f \u0641\u0623\u0643\u0645\u0644\u0648\u0627 \u0644\u0647 \u0645\u0627 \u0646\u0642\u0635 \u0645\u0646 \u0641\u0631\u064a\u0636\u062a\u0647\u060c \u062b\u0645 \u0627\u0644\u0632\u0643\u0627\u0629\u060c \u062b\u0645 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0639\u0644\u0649 \u062d\u0633\u0628 \u0630\u0644\u0643\".","attribution":"\u0631\u0648\u0627\u0647 \u0623\u0628\u0648 \u062f\u0627\u0648\u062f \u0648\u0627\u0628\u0646 \u0645\u0627\u062c\u0647 \u0648\u0627\u0644\u062f\u0627\u0631\u0645\u064a","grade":"\u062d\u0633\u0646","explanation":"\u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645: \u0625\u0646 \u0623\u0648\u0644 \u0634\u064a\u0621 \u064a\u062d\u0627\u0633\u0628 \u0639\u0644\u064a\u0647 \